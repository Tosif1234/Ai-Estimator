generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  CLIENT
}

enum GapPriority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum GapStatus {
  OPEN
  RESOLVED
}

enum QuestionPriority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum QuestionStatus {
  PENDING
  ANSWERED
  SKIPPED
}

model Project {
  id          String  @id @default(cuid())
  name        String
  description String?
  status      String  @default("DRAFT")
  userId      String?

  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  requirements Requirement[]
  estimates    Estimate[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Requirement {
  id        String @id @default(cuid())
  projectId String
  rawText   String
  analysis  Json?

  completenessScore Float?

  project   Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  gaps      RequirementGap[]
  questions RequirementQuestion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
}

model RequirementGap {
  id            String      @id @default(cuid())
  requirementId String
  title         String
  description   String
  priority      GapPriority
  status        GapStatus   @default(OPEN)
  moduleName    String?
  impact        String?

  requirement Requirement           @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  questions   RequirementQuestion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([requirementId])
  @@index([status])
  @@index([priority])
}

model RequirementQuestion {
  id                String           @id @default(cuid())
  requirementId     String
  question          String
  priority          QuestionPriority
  moduleName        String?
  gapId             String?
  answer            String?
  options           Json?
  allowCustomAnswer Boolean          @default(true)
  status            QuestionStatus   @default(PENDING)

  requirement Requirement         @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  gap         RequirementGap?     @relation(fields: [gapId], references: [id], onDelete: SetNull)
  answers     RequirementAnswer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([requirementId])
  @@index([gapId])
  @@index([status])
  @@index([priority])
}

model RequirementAnswer {
  id         String @id @default(cuid())
  questionId String
  answer     String

  question RequirementQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([questionId])
}

model EstimationRule {
  id            String         @id @default(cuid())
  featureName   String         @unique
  category      String?
  complexity    String?
  baseHours     Float
  aliases       String[]
  estimateItems EstimateItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Estimate {
  id         String         @id @default(cuid())
  projectId  String
  version    Int            @default(1)
  totalHours Float
  project    Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  items      EstimateItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
}

model EstimateItem {
  id          String  @id @default(cuid())
  estimateId  String
  ruleId      String?
  moduleName  String
  featureName String
  description String?
  category    String?
  complexity  String?
  hours       Float

  estimate Estimate              @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  rule     EstimationRule?       @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  subtasks EstimateItemSubtask[]

  createdAt DateTime @default(now())

  @@index([estimateId])
  @@index([ruleId])
}

model EstimateItemSubtask {
  id            String      @id @default(cuid())
  estimateItemId String
  name          String
  description   String
  hours         Float

  estimateItem EstimateItem @relation(fields: [estimateItemId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([estimateItemId])
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  role      Role     @default(CLIENT)
  avatarUrl String?

  projects          Project[]
  sessions          RefreshSession[]
  passwordResetOtps PasswordResetOtp[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RefreshSession {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetOtp {
  id         String    @id @default(cuid())
  userId     String
  otpHash    String
  expiresAt  DateTime
  attempts   Int       @default(0)
  verifiedAt DateTime?
  usedAt     DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}
